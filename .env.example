# Copy to .env (or point LMM_SECRETS_FILE at a file outside the repo).
# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the same app page, for verified webhooks
PAYPAL_WEBHOOK_ID=
# AI: OpenRouter key (https://openrouter.ai/keys); models default to Claude Sonnet 5.5 / Haiku 5.5
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5.5
# Public base URL of this app (used for PayPal return URLs)
PUBLIC_URL=http://localhost:8000
# Prodigi print-on-demand, SANDBOX key (starts with test_): https://sandbox-beta-dashboard.pwinty.com
PRODIGI_ENV=sandbox
PRODIGI_API_KEY=
